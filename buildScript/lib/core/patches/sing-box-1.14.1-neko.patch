diff --git a/service/oomkiller/lock_unix.go b/service/oomkiller/lock_unix.go
new file mode 100644
index 0000000..677b20f
--- /dev/null
+++ b/service/oomkiller/lock_unix.go
@@ -0,0 +1,26 @@
+//go:build !windows
+
+package oomkiller
+
+import (
+	"os"
+	"syscall"
+)
+
+func lockDraft(path string) (*os.File, error) {
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o666)
+	if err != nil {
+		return nil, err
+	}
+	err = syscall.Flock(int(file.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
+	if err != nil {
+		file.Close()
+		return nil, err
+	}
+	return file, nil
+}
+
+func unlockDraft(file *os.File) {
+	syscall.Flock(int(file.Fd()), syscall.LOCK_UN)
+	file.Close()
+}
diff --git a/service/oomkiller/lock_windows.go b/service/oomkiller/lock_windows.go
new file mode 100644
