+func (t *sbStatsFlowTracker) CountForward(n int) {
+	for _, counter := range t.uplinkCounter {
+		counter.Add(int64(n))
+	}
+}
+
+func (t *sbStatsFlowTracker) CountReverse(n int) {
+	for _, counter := range t.downlinkCounter {
+		counter.Add(int64(n))
+	}
+}
